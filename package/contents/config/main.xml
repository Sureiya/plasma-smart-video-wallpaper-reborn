<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0
      http://www.kde.org/standards/kcfg/1.0/kcfg.xsd" >
  <kcfgfile name=""/>

  <group name="General">
    <entry name="VideoUrls" type="String">
      <label>List of video urls</label>
      <default>[]</default>
    </entry>
    <entry name="Folders" type="String">
      <label>Folder paths to enumerate recursively</label>
      <default>[]</default>
    </entry>
    <entry name="BackgroundColor" type="String">
      <label>Background color</label>
      <default>#000000</default>
    </entry>
    <entry name="AudioOutputDevice" type="String">
      <label>Audio output device</label>
      <default></default>
    </entry>
    <entry name="FillMode" type="Int">
      <label>Video fill mode</label>
      <default>2</default>
    </entry>
    <!-- Video pause mode
        0: when existing a maximized or full-screen windows
        1: when a visible window is active
        2: when a window is visible
        3: never
    -->
    <entry name="PauseMode" type="Int">
      <default>0</default>
    </entry>
    <entry name="PauseCoveragePercent" type="Int">
      <label>Pause video when visible windows cover more than this percent of the screen</label>
      <default>75</default>
    </entry>
    <entry name="PauseBatteryLevel" type="Int">
      <default>10</default>
    </entry>
    <entry name="BatteryPausesVideo" type="Bool">
      <label>Pause video when battery is below PauseBatteryLevel</label>
      <default>true</default>
    </entry>
    <entry name="BatteryDisablesBlur" type="Bool">
      <label>Disable blur when battery is below PauseBatteryLevel</label>
      <default>false</default>
    </entry>
    <!-- Show blur
        0: when existing a maximized or full-screen windows
        1: when a visible window is active
        2: when a window is visible
        3: video is paused
        4: always
        5: never
    -->
    <entry name="BlurMode" type="Int">
      <default>5</default>
    </entry>
    <entry name="BlurRadius" type="Int">
      <default>32</default>
    </entry>
    <entry name="ScreenOffPausesVideo" type="Bool">
      <label>Pause video when the screen is turned off based on ScreenStateCmd</label>
      <default>false</default>
    </entry>
    <entry name="ScreenStateCmd" type="String">
      <label>Command/script to get the screen state should return 0 for Off and anything else for On state</label>
      <default>cat /sys/class/backlight/intel_backlight/actual_brightness 2> /dev/null || kscreen-doctor --dpms show 2> /dev/null | head -n1 | awk '{print $NF}'</default>
    </entry>
    <entry name="CheckWindowsActiveScreen" type="Bool">
      <label>Whether or not check for windows from all screens instead of just the active one.</label>
      <default>true</default>
    </entry>
    <entry name="DebugEnabled" type="Bool">
      <label>Print log to Journal</label>
      <default>false</default>
    </entry>
    <!-- Desktop effects -->
    <entry name="EffectsPauseVideo" type="String">
      <default></default>
    </entry>
    <entry name="EffectsPlayVideo" type="String">
      <default>windowaperture</default>
    </entry>
    <entry name="EffectsHideBlur" type="String">
      <default></default>
    </entry>
    <entry name="EffectsShowBlur" type="String">
      <default></default>
    </entry>
    <entry name="EffectsAlternativeSpeed" type="String">
      <default></default>
    </entry>
    <entry name="BlurAnimationDuration" type="Int">
      <default>300</default>
    </entry>
    <entry name="CrossfadeEnabled" type="Bool">
      <default>False</default>
    </entry>
    <entry name="CrossfadeDuration" type="Int">
      <default>1000</default>
    </entry>
    <entry name="PlaybackRate" type="Double">
      <default>1</default>
    </entry>
    <entry name="Volume" type="Double">
      <default>1</default>
    </entry>
    <entry name="RandomMode" type="Bool">
      <default>False</default>
    </entry>
    <entry name="LastVideo" type="String">
      <default></default>
    </entry>
    <entry name="LastVideoPosition" type="Int">
      <default>0</default>
    </entry>
    <entry name="LastVideoDay" type="String">
      <default></default>
    </entry>
    <entry name="LastVideoNight" type="String">
      <default></default>
    </entry>
    <entry name="LastVideoSunrise" type="String">
      <default></default>
    </entry>
    <entry name="LastVideoSunset" type="String">
      <default></default>
    </entry>
    <!-- Mute audio
        0: when maximized or full-screen windows
        1: when a visible window is active
        2: when a window is visible
        3: TODO application playing audio
        4: never
        5: always
    -->
    <entry name="MuteMode" type="Int">
      <default>5</default>
    </entry>
    <entry name="ChangeWallpaperMode" type="Int">
      <default>1</default>
    </entry>
    <entry name="ChangeWallpaperTimerSeconds" type="Int">
      <default>0</default>
    </entry>
    <entry name="ChangeWallpaperTimerMinutes" type="Int">
      <default>10</default>
    </entry>
    <entry name="ChangeWallpaperTimerHours" type="Int">
      <default>0</default>
    </entry>
    <!-- Minimum random interval to change wallpaper (hours/minutes/seconds) -->
    <entry name="RandomIntervalMinHours" type="Int">
      <default>0</default>
    </entry>
    <entry name="RandomIntervalMinMinutes" type="Int">
      <default>1</default>
    </entry>
    <entry name="RandomIntervalMinSeconds" type="Int">
      <default>0</default>
    </entry>
    <!-- Maximum random interval to change wallpaper (hours/minutes/seconds) -->
    <entry name="RandomIntervalMaxHours" type="Int">
      <default>0</default>
    </entry>
    <entry name="RandomIntervalMaxMinutes" type="Int">
      <default>30</default>
    </entry>
    <entry name="RandomIntervalMaxSeconds" type="Int">
      <default>0</default>
    </entry>
    <entry name="RandomStartTime" type="Bool">
      <label>Start playing each video at a random position</label>
      <default>False</default>
    </entry>
    <entry name="DayNightCycleMode" type="Int">
      <label>Mode</label>
      <default>0</default>
    </entry>
    <entry name="DayNightCycleSunriseTime" type="Int">
      <label>Time of sunrise</label>
      <default>360</default>
    </entry>
    <entry name="DayNightCycleSunsetTime" type="Int">
      <label>Time of sunset</label>
      <default>1080</default>
    </entry>
    <entry name="DayNightCycleTransitionDuration" type="Int">
      <label>Duration of sunrise and sunset (minutes)</label>
      <default>5</default>
    </entry>
    <entry name="ResumeLastVideo" type="Bool">
      <label>Whether or not to resume last playing video on startup</label>
      <default>True</default>
    </entry>
    <entry name="FillBlur" type="Bool">
      <label>Blur background filling</label>
      <default>true</default>
    </entry>
    <entry name="FillBlurRadius" type="Int">
      <default>64</default>
    </entry>
    <!-- Alternative playback rate
        0: when existing a maximized or full-screen windows
        1: when a visible window is active
        2: when a window is visible
        3: never
    -->
    <entry name="AlternativePlaybackRateMode" type="Int">
      <default>3</default>
    </entry>
    <entry name="AlternativePlaybackRate" type="Double">
      <default>0.5</default>
    </entry>
    <entry name="DarkLightScheduleState" type="String">
      <label>Saved dark light schedule state</label>
      <default></default>
    </entry>
    <entry name="AudioFadeInOutDuration" type="Int">
      <default>0</default>
    </entry>
    <entry name="LoadAheadTime" type="Int">
      <default>1000</default>
    </entry>
    <entry name="AdvanceOnVideoEnd" type="Bool">
      <label>Play the next video when the current one ends instead of looping</label>
      <default>true</default>
    </entry>
    <!-- Tiles mode: play multiple videos simultaneously in a masonry layout -->
    <entry name="TilesMaxTiles" type="Int">
      <label>Maximum number of simultaneous video tiles</label>
      <default>6</default>
    </entry>
    <entry name="TilesMergeDuration" type="Int">
      <label>Duration in ms of the tile merge animation</label>
      <default>1500</default>
    </entry>
    <entry name="TilesRandomize" type="Bool">
      <label>Reshuffle tile assignment each merge cycle</label>
      <default>true</default>
    </entry>
    <entry name="TilesAspectTolerance" type="Int">
      <label>Percent of stretch/crop tolerated before relaxing a tile's aspect</label>
      <default>10</default>
    </entry>
    <entry name="TilesLayoutStyle" type="Int">
      <label>Tile layout style (0=Brick, 1=Mosaic, 2=Hero, 3=Collage)</label>
      <default>0</default>
    </entry>
    <entry name="TilesTransformsBeforeFull" type="Int">
      <label>Number of converge transforms before tiles reach full screen</label>
      <default>5</default>
    </entry>
    <entry name="TilesSegmentMinS" type="Int">
      <label>Minimum video segment length in seconds</label>
      <default>3</default>
    </entry>
    <entry name="TilesSegmentMaxS" type="Int">
      <label>Maximum video segment length in seconds</label>
      <default>15</default>
    </entry>
    <entry name="TilesChoreographyMode" type="Int">
      <label>Tile choreography (0=merge to one, 1=maze walk)</label>
      <default>0</default>
    </entry>
    <entry name="TilesHeroSecondaryMode" type="Int">
      <label>Hero secondary layout (0=side grid, 1=brick, 2=columns, 3=rows, 4=mosaic, 5=collage, 6=random)</label>
      <default>0</default>
    </entry>
    <entry name="TilesMazeSize" type="Int">
      <label>Maze walk size: size of the tile-count state space the walker roams (directs wander breadth)</label>
      <default>5</default>
    </entry>
  </group>
</kcfg>
